# Parsley environment template. Nothing here is required — the app runs entirely
# on built-in defaults and uses no secrets. Copy to .env and uncomment only what
# you need to override.

# ── Backend (read in backend/app/config.py) ──────────────────────────────────

# Rate-limit storage. Default memory:// is per-instance (resets on cold start);
# point at a shared store (e.g. Redis) to make the cap global on a scaled deploy.
# Redis needs its client installed first (`uv add redis` in backend/), or the
# backend fails at startup. slowapi's own RATELIMIT_STORAGE_URL is ignored.
#RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# ── Frontend (dev only) ──────────────────────────────────────────────────────

# Where the Vite dev proxy sends /api/* (docker-compose sets this in-container;
# bare-metal dev defaults to localhost:8000 without it).
#VITE_API_PROXY=http://localhost:8000
